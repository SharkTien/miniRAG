# Copy to .env and replace every placeholder before starting the stack.
APP_ENV=development
APP_PORT=41873
FRONTEND_PORT=4173
MINIO_CONSOLE_PORT=41901

# Application runtime
MAX_UPLOAD_BYTES=209715200
INGESTION_WORKER_CONCURRENCY=2

# PostgreSQL / pgvector
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-database-password

# pgAdmin giao diện quản trị PostgreSQL
PGADMIN_PORT=41874
PGADMIN_DEFAULT_EMAIL=admin@company.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-pgadmin-password

# MinIO
MINIO_ROOT_USER=rag_minio
MINIO_ROOT_PASSWORD=replace-with-a-minio-password

# Optional hosted model credentials. Leave blank to run the API without model calls.
NGC_API_KEY=
HF_TOKEN=
HF_KEY=

# Document extraction and OCR
DOCUMENT_PARSER_ENGINE=auto
RAGFLOW_MODE=deepdoc
DOCLING_DEVICE=cpu
DOCLING_DO_OCR=auto
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_NUM_THREADS=4
DOCLING_OCR_BATCH_SIZE=4
DOCLING_FORCE_FULL_PAGE_OCR=true
DOCLING_OCR_ENGINE=tesseract
DOCLING_OCR_LANG=vie,eng
DOCLING_TESSERACT_PSM=3
DOCLING_TESSERACT_OSD=false
# Hosted NVIDIA NeMo Retriever OCR v2 for PDF scans and images.
NVIDIA_OCR_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NVIDIA_OCR_MODEL=nvidia/nemotron-ocr-v2
NVIDIA_OCR_TIMEOUT_SECONDS=180
NVIDIA_OCR_BATCH_SIZE=2
NVIDIA_OCR_CONCURRENCY=4
LOCAL_OCR_BASE_URL=http://host.docker.internal:8012
LOCAL_OCR_TIMEOUT_SECONDS=180
LOCAL_OCR_DPI=180
LOCAL_OCR_BATCH_SIZE=2
TESSERACT_PAGE_CONCURRENCY=4
TESSERACT_PAGE_TIMEOUT_SECONDS=90
SEMANTIC_NORMALIZER=nvidia
SEMANTIC_NORMALIZE_OCR_ONLY=true
SEMANTIC_OCR_CONFIDENCE_GATE=0.93
PERSIST_PAGE_VISUALS=true
PAGE_VISUAL_SCALE=1.5

# NVIDIA NIM / embeddings
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NIM_TIMEOUT_SECONDS=120
NIM_REQUEST_TIMEOUT_SECONDS=30
NIM_MAX_RETRIES=1
NIM_NORMALIZATION_DEADLINE_SECONDS=45
NIM_CONCURRENCY=4
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_DIM=2048
LLM_RAG_MODEL=meta/llama-3.2-11b-vision-instruct
TOP_K=10
RETRIEVAL_CANDIDATE_MULTIPLIER=8
SIMILARITY_THRESHOLD=0.2
